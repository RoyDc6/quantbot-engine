{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuantBot Codex review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "risk_level",
    "findings",
    "validation_recommended"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "risk_level": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low", "none"]
    },
    "findings": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "severity",
          "title",
          "path",
          "line",
          "body",
          "confidence",
          "safety_boundary"
        ],
        "properties": {
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "safety_boundary": {
            "type": "string",
            "enum": [
              "execution",
              "credentials",
              "provenance",
              "market_separation",
              "reproducibility",
              "correctness",
              "none"
            ]
          }
        }
      }
    },
    "validation_recommended": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    }
  }
}
